<Page x:Class="DiplomacyReplay.MapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DiplomacyReplay"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MapPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border BorderBrush="Red" BorderThickness="5" Grid.Column="1" Grid.ColumnSpan="2" Background="CornflowerBlue">
            <TextBlock Text="MAP PLACEHOLDER" Background="IndianRed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="50"/>
        </Border>
        
        <local:SidebarControl x:Name="sidebar" Grid.Column="0" Grid.ColumnSpan="2" 
ContentVisibility="Visible">
            <local:SidebarItem Header="Image">
                <StackPanel Orientation="Vertical" Margin="10"
                            HorizontalAlignment="Stretch">
                    <TextBox Text="No Image Selected" IsReadOnly="True" 
                             HorizontalAlignment="Stretch"/>
                </StackPanel>
            </local:SidebarItem>
            <local:SidebarItem Header="Territories">
                <TextBlock Text="TWO"/>
            </local:SidebarItem>
            <local:SidebarItem Header="Countries">
                <TextBlock Text="Three"/>
            </local:SidebarItem>
        </local:SidebarControl>
    </Grid>
</Page>
