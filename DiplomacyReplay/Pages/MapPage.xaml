<Page x:Class="DiplomacyReplay.MapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      xmlns:local="clr-namespace:DiplomacyReplay"
      xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="MapPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Background="DarkCyan">
            <Border x:Name="viewboxBorder"
                    BorderThickness="2" BorderBrush="Red" Background="LightCyan">
                <skia:SKElement x:Name="mapCanvas" 
                                    Cursor="SizeAll"
                                    PaintSurface="mapCanvas_PaintSurface"/>
            </Border>
        </ScrollViewer>

        <local:SidebarControl x:Name="sidebar" Grid.Column="0" Grid.ColumnSpan="2"
d:ContentVisibility="Visible">
            <!--General Sidebar Tab-->
            <local:SidebarItem Header="General">
                <GroupBox Header="Map Background" Margin="20" Padding="5">
                    <Grid>
                        <!--Load Background Buton-->
                        <Button x:Name="LoadBackgroundButton" Content="Load Image"  HorizontalAlignment="Center"
                                Width="150" Height="50"
                                Click="LoadImageButton_Click">
                            <!--Show button if no image loaded-->
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackgroundLocation}" Value="No File Loaded">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!--Background File Location-->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=LoadBackgroundButton}" Value="Collapsed">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock x:Name="imageFile" Margin="0,0,15,0" VerticalAlignment="Center"
                               Text="{Binding BackgroundLocation}"
                               ToolTip="{Binding BackgroundLocation}"/>

                            <Button Style="{StaticResource CloseButtonStyle}"
                                    Click="CloseBackgroundButton_Click"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </local:SidebarItem>

            <!--Territories Sidebar Tab-->
            <local:SidebarItem Header="Territories">
                <local:SidebarItem.Content>
                    <local:MapTerritoryTabContent DataContext="{Binding}"/>
                </local:SidebarItem.Content>
            </local:SidebarItem>

            <!--Countries Sidebar Tab-->
            <local:SidebarItem Header="Countries">
                <local:SidebarItem.Content>
                    <local:MapCountryTabContent DataContext="{Binding}"/>
                </local:SidebarItem.Content>
            </local:SidebarItem>

        </local:SidebarControl>
    </Grid>
</Page>