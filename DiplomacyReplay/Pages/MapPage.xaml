<Page x:Class="DiplomacyReplay.MapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DiplomacyReplay"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MapPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="viewboxBorder" Grid.Column="1" Grid.ColumnSpan="2"
                BorderThickness="3" BorderBrush="Red"
                Background="Aquamarine">
            <Viewbox Stretch="None">
                <Image x:Name="canvasElement" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Viewbox>
        </Border>



        <local:SidebarControl x:Name="sidebar" Grid.Column="0" Grid.ColumnSpan="2" >
            <local:SidebarItem Header="Image">
                <StackPanel Orientation="Vertical" Margin="20">
                    <TextBlock Text="Map Background:" FontSize="15" FontWeight="Bold" TextDecorations="Underline"/>
                    <TextBlock x:Name="imageFile" Margin="15,0,0,0"
                               Text="{Binding BackgroundLocation, RelativeSource={RelativeSource AncestorType={x:Type local:MapPage}}}"
                               ToolTip="{Binding BackgroundLocation, RelativeSource={RelativeSource AncestorType={x:Type local:MapPage}}}"/>
                    <Button x:Name="LoadImageButton" Content="Load Image" Margin="0,25,0,0"
                            Click="LoadImageButton_Click"/>
                </StackPanel>
            </local:SidebarItem>
            
            <local:SidebarItem Header="Territories">
                <TextBlock Text="TWO"/>
            </local:SidebarItem>
            
            <local:SidebarItem Header="Countries">
                <TextBlock Text="Three"/>
            </local:SidebarItem>
        </local:SidebarControl>
    </Grid>
</Page>
