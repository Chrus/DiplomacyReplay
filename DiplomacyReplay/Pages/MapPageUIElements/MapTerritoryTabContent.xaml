<UserControl x:Class="DiplomacyReplay.MapTerritoryTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiplomacyReplay"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="250" d:Background="CornflowerBlue"
             
             DataContextChanged="UserControl_DataContextChanged">
    <UserControl.Resources>
        <local:TypeToVisibilityConverter x:Key="T2VC"/>
        <local:ExtraGarrisonVisibilityConverter x:Key="XGVC"/>
    </UserControl.Resources>

    <Grid Background="CornflowerBlue">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!--Editor for when DipMap isnt finalized-->
            <StackPanel x:Name="NotFinalizedPane" Margin="20" HorizontalAlignment="Stretch"
d:Visibility="Collapsed">
                <Button x:Name="FinalizeButton" Content="Finalize" Height="30" Width="60"
                        Click="FinalizeButton_Click"/>

                <Separator Margin="-10,10,-10,10" Background="DarkBlue" />

                <!--Selection Box-->
                <ListBox x:Name="TerList" MinHeight="100" MaxHeight="150"
                         ItemsSource="{Binding Territories}" DisplayMemberPath="Name">
                </ListBox>

                <Separator Margin="5,10,5,10" Background="DarkBlue"/>

                <!--Selection Box Buttons-->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-20,0,10">
                    <Button x:Name="AddTerritoryButton" Content="+" Width="20" Height="20" Margin="2,0,2,0"
                            Click="AddTerritoryButton_Click"/>
                    <Button x:Name="RemoveTerritoryButton" Content="-" Width="20" Height="20" Margin="2,0,2,0"
                            Click="RemoveTerritoryButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=Territories.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!--Selected Item Presenter-->
                <Border BorderBrush="DarkBlue" BorderThickness="2" Padding="10" Margin="-5,0,-5,-5" d:Visibility="Visible">
                    <!--Hide Panel if no item selected-->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=TerList}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Orientation="Vertical">
                        <!--Name-->
                        <GroupBox Header="Name" Padding="5">
                            <StackPanel Orientation="Vertical">
                                <TextBox x:Name="NameBox" Text="{Binding SelectedItem.Name, ElementName=TerList, UpdateSourceTrigger=PropertyChanged}"/>

                                <local:LocationSelector LocationName="Location: "
                                    SelectedLocation="{Binding SelectedItem.NameLoc, ElementName=TerList, Mode=TwoWay}"/>
                            </StackPanel>
                        </GroupBox>

                        <!--Territory Type-->
                        <GroupBox Header="Type" Padding="5">
                            <StackPanel Orientation="Vertical">
                                <RadioButton x:Name="LandBut" Content="Land"
                                             Click="TypeButton_Click">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.TerritoryType, ElementName=TerList}" Value="LAND">
                                                    <Setter Property="IsChecked" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                                <RadioButton x:Name="CoastBut" Content="Coast"
                                             Click="TypeButton_Click">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.TerritoryType, ElementName=TerList}" Value="COAST">
                                                    <Setter Property="IsChecked" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                                <RadioButton x:Name="WaterBut" Content="Water"
                                             Click="TypeButton_Click">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.TerritoryType, ElementName=TerList}" Value="WATER">
                                                    <Setter Property="IsChecked" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                            </StackPanel>
                        </GroupBox>

                        <!--Supply Point-->
                        <Button x:Name="MakeSupplyBut" Content="Make Supply Point" Margin="5"
                                Click="AddRemSupply_Click">
                            <!--Hide Button if already a supply point-->
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.IsSupply, ElementName=TerList}" Value="true">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <GroupBox>
                            <!--Hide Groupbox if not a supply point-->
                            <GroupBox.Style>
                                <Style TargetType="GroupBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.IsSupply, ElementName=TerList}" Value="true">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.IsSupply,ElementName=TerList}" Value="false">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupBox.Style>

                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Supply Point"/>
                                    <Button x:Name="RemoveSupplyBut" Content="  -  " Margin="5,0,0,0"
                                            Click="AddRemSupply_Click"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <StackPanel Orientation="Vertical">
                                <local:LocationSelector SelectedLocation="{Binding SelectedItem.SupplyLocation, ElementName=TerList, Mode=TwoWay}"/>
                            </StackPanel>
                        </GroupBox>

                        <!--Garrison-->
                        <GroupBox Header="Garrison">
                            <StackPanel Orientation="Vertical">
                                <local:LocationSelector SelectedLocation="{Binding SelectedItem.GarrisonLoc, ElementName=TerList, Mode=TwoWay}"/>

                                <Separator Margin="5,15,5,10" Background="DarkBlue"/>

                                <!--Extra Garrisons-->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-20,0,10">
                                    <Button Content="+" Width="20" Height="20" Margin="2,0,2,0"
                                            Click="AddExtraGarrisonBut_Click"/>
                                    <Button x:Name="RemExtraGarrisonBut" Content="-" Width="20" Height="20" Margin="2,0,2,0"
                                            Click="RemExtraGarrisonBut_Click">
                                        <!--Hide Remove Garrison Button if there are none-->
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=ExtraGarListBox}" Value="false">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <ListBox x:Name="ExtraGarListBox" ItemsSource="{Binding SelectedItem.ExtraGarrisons, ElementName=TerList}">
                                    <!--Hide Extra Garrison box if there are none-->
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=ExtraGarListBox}" Value="false">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical">
                                                <TextBox x:Name="ExtraGarrisonTextBox" Text="{Binding Name}"
                                                         GotFocus="ExtraGarrisonTextBox_GotFocus"/>
                                                <local:LocationSelector SelectedLocation="{Binding Location, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--Pane displayed when DipMap Finalized-->
        <ListBox x:Name="FinalizedPane" ItemsSource="{Binding Territories}"
                 Background="CornflowerBlue" HorizontalContentAlignment="Stretch" BorderThickness="0"
                 ScrollViewer.CanContentScroll="False">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="3" BorderBrush="DarkBlue" Margin="2,2.5,2,2.5" Padding="5" Background="CornflowerBlue">
                        <StackPanel Orientation="Vertical">
                            <!--Name-->
                            <local:LocationSelector HorizontalAlignment="Left"
                                                            LocationName="{Binding Name}"
                                                            SelectedLocation="{Binding NameLoc}"
                                                            TextFirst="False" CanEdit="False"/>
                            <!--Territory Type-->
                            <TextBlock Text="{Binding TerritoryType}"/>

                            <!--Supply location-->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                        Visibility="{Binding Converter={StaticResource T2VC}}">
                                <local:LocationSelector LocationName="Supply"
                                                                SelectedLocation="{Binding SupplyLocation}"
                                                                TextFirst="False" CanEdit="False" />
                            </StackPanel>

                            <!--Garrison Location-->
                            <local:LocationSelector LocationName="Garrison" HorizontalAlignment="Left"
                                                            SelectedLocation="{Binding GarrisonLoc}"
                                                            TextFirst="False" CanEdit="False"/>

                            <!--Extra Garrison Locations-->
                            <ItemsControl ItemsSource="{Binding ExtraGarrisons}"
                                     Visibility="{Binding Converter={StaticResource XGVC}}"
                                     Background="CornflowerBlue">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:LocationSelector HorizontalAlignment="Left" TextFirst="False" CanEdit="False" Margin="10,0,0,0"
                                                                        LocationName="{Binding Name}"
                                                                        SelectedLocation="{Binding Location}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
