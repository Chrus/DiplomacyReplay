<UserControl x:Class="DiplomacyReplay.MapCountryTabContent"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"            
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiplomacyReplay"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             
             DataContextChanged="UserControl_DataContextChanged">
    <UserControl.Resources>
        <local:Xceed_SKColorConverter x:Key="XSKCC"/>
        <local:SKColorToBrushConverter x:Key="SKCTBC"/>
        <local:GetTerritoryLocationConverter x:Key="GTLC"/>
    </UserControl.Resources>
    
    <Grid Background="CornflowerBlue">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!--Pane displayed when DipMap has not been finalized-->
            <StackPanel x:Name="NotFinalizedPane" Margin="20" HorizontalAlignment="Stretch">
                <!--Finalize Button-->
                <Button Content="Finalize" Height="30"
                        Click="FinalizeButton_Click"/>

                <Separator Margin="-10,10,-10,10" Background="DarkBlue" />

                <!--Country Listbox-->
                <ListBox x:Name="CountryList" MinHeight="100" ItemsSource="{Binding Countries.Values}" DisplayMemberPath="Name"
                         SelectionChanged="CountryList_SelectionChanged">
                </ListBox>

                <Separator Margin="5,10,5,10" Background="DarkBlue"/>

                <!--Add/Remove Country buttons-->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-20,0,10">
                    <Button x:Name="AddCountryButton" Content="+" Width="20" Height="20" Margin="2,0,2,0"
                        Click="AddCountryButton_Click"/>
                    <Button x:Name="RemoveCountryButton" Content="-" Width="20" Height="20" Margin="2,0,2,0"
                        Click="RemoveCountryButton_Click">
                        <!--Hide Remove Country Button if list is empty-->
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Countries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!--Country Detail Panel when not finalized-->
                <Border BorderBrush="DarkBlue" BorderThickness="2" Padding="10" Margin="-5,0,-5,-5">
                    <!--Hide Detail Panel when no CountryList item is selected-->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=CountryList}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    
                    <StackPanel Orientation="Vertical">
                        <!--Country Name-->
                        <GroupBox Header="Name">
                            <TextBox x:Name="NameBox" Text="{Binding SelectedItem.Name, ElementName=CountryList}"
                                 LostFocus="NameBox_LostFocus"
                                 KeyDown="NameBox_KeyDown"/>
                        </GroupBox>

                        <!--Country Color-->
                        <GroupBox Header="Color">
                            <xctk:ColorPicker x:Name="colorPicker" ShowStandardColors="False"
                                           SelectedColor = "{Binding SelectedItem.Color, ElementName=CountryList, Converter={StaticResource XSKCC}}"/>
                        </GroupBox>

                        <!--Country Spawn Points-->
                        <GroupBox Header="Spawn Points" Padding="5">
                            <StackPanel Orientation="Vertical">
                                <xctk:CheckComboBox x:Name="spawnSelector" MaxWidth="200"
                                                    ItemsSource="{Binding Territories.Values}" DisplayMemberPath="Name"
                                                    Closed="spawnSelector_Closed">
                                </xctk:CheckComboBox>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                    <ItemsControl x:Name="selectedSpawns" ItemsSource="{Binding SelectedItem.SpawnPoints, ElementName=CountryList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <local:LocationSelector CanEdit="False" TextFirst="False"
                                                                        LocationName="{Binding}">
                                                    <local:LocationSelector.SelectedLocation>
                                                        <MultiBinding Converter="{StaticResource GTLC}">
                                                            <Binding/>
                                                            <Binding ElementName="spawnSelector" Path="ItemsSource"/>
                                                        </MultiBinding>
                                                    </local:LocationSelector.SelectedLocation>
                                                </local:LocationSelector>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--Panel that is visiable when DipMap is Finalized-->
        <ListBox x:Name="FinalizedPane" ItemsSource="{Binding Countries.Values}" Background="CornflowerBlue"
                 BorderThickness="0" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="DarkBlue" BorderThickness="3" Padding="5">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <!--Country Color-->
                                <Ellipse Width="20" Height="20" StrokeThickness="2" Stroke="Black"
                                     Fill="{Binding Color,Converter={StaticResource SKCTBC}}"/>
                                <!--Country Name-->
                                <TextBlock Text="{Binding Name}" Margin="15,0,0,0"/>
                            </StackPanel>

                            <!--Spawn Points-->
                            <ItemsControl ItemsSource="{Binding SpawnPoints}" Margin="15,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:LocationSelector CanEdit="False" TextFirst="False"
                                                            LocationName="{Binding}">
                                            <local:LocationSelector.SelectedLocation>
                                                <MultiBinding Converter="{StaticResource GTLC}">
                                                    <Binding/>
                                                    <Binding ElementName="spawnSelector" Path="ItemsSource"/>
                                                </MultiBinding>
                                            </local:LocationSelector.SelectedLocation>
                                        </local:LocationSelector>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
