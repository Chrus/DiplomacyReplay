<Page x:Class="DiplomacyReplay.TimelinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DiplomacyReplay"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TimelinePage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border BorderBrush="Red" BorderThickness="5" Grid.Column="1" Grid.ColumnSpan="2" Background="CornflowerBlue">
            <TextBlock Text="TIMELINE PLACEHOLDER" Background="DarkRed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="50"/>
        </Border>

        <local:SidebarControl x:Name="sidebar" Grid.Column="0" Grid.ColumnSpan="2" Background="Orange">
            <local:SidebarItem Header="Timeline">
                <TextBlock Text="ONE"/>
            </local:SidebarItem>
            <local:SidebarItem Header="Editor">
                <TextBlock Text="TWO"/>
            </local:SidebarItem>
            <local:SidebarItem Header="Import">
                <TextBlock Text="Three"/>
            </local:SidebarItem>
        </local:SidebarControl>
    </Grid>
</Page>
