<Page x:Class="DiplomacyReplay.DipPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DiplomacyReplay"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DipPage">
    <Page.Resources>
        <local:WidthConverter x:Key="widthConverter"/>
    </Page.Resources>

    <Grid Name="baseGrid">
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>-->

        <Rectangle Grid.Column="1" Grid.ColumnSpan="2" Fill="Cyan"/>

        <local:SidebarControl Height="200" VerticalAlignment="Top"
                              x:Name="sidebarControl">
            <local:SidebarItem x:Name="widthSidebarItem" Header="fdsaaaa" >
                <Rectangle Width="100" Height="43" Fill="Purple" />
            </local:SidebarItem>

            <TabItem Header="2test">
                <Rectangle Width="100" Height="40" Fill="Orange"/>
            </TabItem>

            <TabItem Header="3test">
                <Rectangle Width="100" Height="40" Fill="DarkGoldenrod"/>
            </TabItem>
        </local:SidebarControl>

        <!--<Canvas Name="testCanvas" Grid.Column="0" Grid.ColumnSpan="1"
                Background="Red" 
                Height="300"
                MouseDown="Canvas_MouseDown">
        </Canvas>-->

    </Grid>
</Page>
