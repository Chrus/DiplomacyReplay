<Application x:Class="DiplomacyReplay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiplomacyReplay"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <Border x:Key="CustomBorder1" BorderBrush="#2246BD" BorderThickness="3" CornerRadius="5">
            <Border BorderBrush="Black" BorderThickness="1" CornerRadius="3">
                <Border BorderBrush="#2293BD" BorderThickness="2" CornerRadius="1" Padding="4" Background="#BD4C22">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Border>
        </Border>

        <Border x:Key="CustomBorder2" BorderBrush="#BD4C22" BorderThickness="3" CornerRadius="5">
            <Border BorderBrush="Black" BorderThickness="1" CornerRadius="3">
                <Border BorderBrush="#DB6337" BorderThickness="2" CornerRadius="1" Padding="4" Background="CornflowerBlue">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Border>
        </Border>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Content">
                <Setter.Value>
                    <Grid>
                        <Ellipse Width="20" Height="20" Fill="Red" StrokeThickness="3" Stroke="Black"/>
                        <TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,0,1.5"/>
                    </Grid>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
