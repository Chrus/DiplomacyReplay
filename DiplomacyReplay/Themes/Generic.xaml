<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DiplomacyReplay">

    <!-- Style for the TabControl -->
    <Style TargetType="local:SidebarControl">
        <!-- Set the TabPanel's behavior -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SidebarControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <!-- TabPanel holds the headers -->
                        <Border>
                            <UniformGrid x:Name="HeaderPanel" 
                                         IsItemsHost="True" 
                                         Rows="1">
                            </UniformGrid>
                        </Border>

                        <!-- The content of the TabControl (selected TabItem) -->
                        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent" 
                                          Grid.Row="1">
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for the TabItem to control tab header appearance -->
    <Style TargetType="local:SidebarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SidebarItem">
                    <Grid>
                        <Border BorderBrush="Green" BorderThickness="5">
                            <ContentPresenter x:Name="ContentSite"
                              HorizontalAlignment="Center"
                              ContentSource="Header"
                              RecognizesAccessKey="True">
                                <ContentPresenter.LayoutTransform>
                                    <RotateTransform Angle="90"/>
                                </ContentPresenter.LayoutTransform>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
