<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DiplomacyReplay">

    <!-- Style for the TabControl -->
    <Style TargetType="local:SidebarControl">
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>

        <!--Set the TabPanel's behavior-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SidebarControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TabPanel holds the headers -->
                        <Border BorderThickness="0,3,0,0" BorderBrush="MediumBlue">
                            <UniformGrid x:Name="HeaderPanel" 
                                         IsItemsHost="True" 
                                         Columns="1">
                            </UniformGrid>
                        </Border>

                        <!-- The content of the TabControl (selected TabItem) -->
                        <Border x:Name="selectedContent" Grid.Column="1" BorderBrush="MediumBlue" BorderThickness="0,3,3,3" Background="CornflowerBlue">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent" 
                                          Grid.Column="1">
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for the TabItem to control tab header appearance -->
    <Style TargetType="local:SidebarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SidebarItem">
                    <Grid>
                        <Border x:Name="contentBorder" BorderThickness="3,0,3,3" BorderBrush="MediumBlue" Background="CornflowerBlue">
                            <ContentPresenter x:Name="ContentSite"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              ContentSource="Header"
                              RecognizesAccessKey="True">
                                <ContentPresenter.LayoutTransform>
                                    <RotateTransform Angle="90"/>
                                </ContentPresenter.LayoutTransform>
                            </ContentPresenter>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="contentBorder"  Property="BorderThickness" Value="3,0,0,3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
